diff --git a/.github/workflows/build-apk.yml b/.github/workflows/build-apk.yml
new file mode 100644
index 0000000..4ca8810
--- /dev/null
+++ b/.github/workflows/build-apk.yml
@@ -0,0 +1,37 @@
+name: Build APK
+
+# Se ejecuta al subir cambios a cualquier rama y también a mano
+# desde la pestaña Actions > "Build APK" > "Run workflow".
+on:
+  push:
+  workflow_dispatch:
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: Instalar JDK 17
+        uses: actions/setup-java@v4
+        with:
+          java-version: '17'
+          distribution: 'temurin'
+          cache: gradle
+
+      - name: Permisos de gradlew
+        run: chmod +x gradlew
+
+      # La variante "debug" se firma sola con la clave de depuración,
+      # así que no hace falta ninguna clave ni secreto.
+      - name: Compilar APK
+        run: ./gradlew assembleGithubDebug --stacktrace
+
+      - name: Subir APK
+        uses: actions/upload-artifact@v4
+        with:
+          name: SamSprung-APK
+          path: app/build/outputs/apk/github/debug/*.apk
+          retention-days: 30
