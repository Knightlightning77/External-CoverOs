<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:id="@+id/widget_preview_frame"
            android:layout_width="120dp"
            android:layout_height="236dp"
            android:background="@android:color/black" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:textColorSecondary"
                android:textSize="13sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_up"
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/widget_move_up"
                    app:srcCompat="@drawable/ic_arrow_up_24dp"
                    app:tint="?android:textColorPrimary" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_down"
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/widget_move_down"
                    app:srcCompat="@drawable/ic_arrow_down_24dp"
                    app:tint="?android:textColorPrimary" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_configure"
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/widget_configure"
                    app:srcCompat="@drawable/ic_settings_24dp"
                    app:tint="?android:textColorPrimary" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_remove"
                    android:layout_width="40dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/widget_remove"
                    app:srcCompat="@drawable/ic_delete_forever_24dp"
                    app:tint="?android:textColorPrimary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
